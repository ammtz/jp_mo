# jp_mo configuration
# Copy to .env (gitignored; chmod 600) and fill in. Never commit real values.
# Verify the wiring with: python -m jp_mo check
# Agents: don't fill this by hand. Follow skills/setup.md (or the user can just say "set me up").
# Real environment variables override this file (useful in cloud sessions).
#
# Interface map (what talks to what):
#
#   [YouTube Data API v3] ---- YOUTUBE_API_KEY ----.
#   [GitHub REST API] -------- GITHUB_TOKEN -------+--> fetch (scripts) --> judge --> edition
#   [ecosyste.ms packages] --- (no key) -----------'                         |
#                                                                            |
#   [Vercel AI Gateway] ------ AI_GATEWAY_API_KEY -----> Jev /v1/evaluate <--'   + curator notes
#   [Notion] ----------------- NOTION_TOKEN -----------> deliver notes, read grades
#                                                       (or chat fallback)

# ---------------------------------------------------------------------------
# 1. JUDGE: Vercel AI Gateway                                       REQUIRED
# ---------------------------------------------------------------------------
# Without it: no judgement, so the run writes "no edition: judge unavailable".
# Get it: Vercel dashboard -> AI Gateway -> API Keys -> Create key
#         (or run `npx vercel ai-gateway setup`).
# Use a long-lived API key, NOT a VERCEL_OIDC_TOKEN: OIDC tokens are
# short-lived and will have expired by the unattended 7AM run.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh

# jev = Jev decision model via POST /v1/evaluate (default, recommended)
# chat = any gateway chat model via /v1/chat/completions (fallback)
JUDGE=jev
JEV_MODEL=typesafe-ai/jev
# Used only when JUDGE=chat. Any model id from https://ai-gateway.vercel.sh/v1/models
CHAT_MODEL=moonshotai/kimi-k3
# Writes the news notes (one call per edition, about $0.07). Disable per run with --no-curator.
CURATOR_MODEL=moonshotai/kimi-k3

# ---------------------------------------------------------------------------
# 2. FEED: GitHub (gh_stars, gh_popular, README excerpts)        RECOMMENDED
# ---------------------------------------------------------------------------
# Without it: the search feeds still run (10 req/min), but README fetches hit
# the 60 req/hour anonymous limit, so most repos get judged without a README.
# Get it: github.com -> Settings -> Developer settings -> Fine-grained tokens
#         Repository access: "Public repositories (read-only)". No permissions needed.
# Set a long expiry, or put a renewal on your calendar: when the token expires,
# the run falls back to anonymous limits.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# 3. FEED: YouTube popular (yt)                                     OPTIONAL
# ---------------------------------------------------------------------------
# Without it: the yt feed is skipped and listed under "feeds failed".
# Get it: console.cloud.google.com -> new project -> APIs & Services ->
#         Library -> enable "YouTube Data API v3" -> Credentials -> API key.
#         Restrict the key to YouTube Data API v3. No OAuth needed.
# Cost: 2 of 10,000 free daily quota units per run.
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# 4. FEED: npm/PyPI packages via packages.ecosyste.ms (pkg)       NO KEY
# ---------------------------------------------------------------------------
# Public API. Requests send a User-Agent of "jp_mo"; nothing to configure.

# ---------------------------------------------------------------------------
# 5. DELIVERY: Notion (read + grade on your phone)                  OPTIONAL
# ---------------------------------------------------------------------------
# Without it: the edition is only a markdown file in EDITION_DIR.
# Get it: notion.so/profile/integrations -> New internal integration -> copy the token.
#         Create a page (e.g. "jp_mo"), then ••• -> Connections -> connect the integration.
# The build creates a "jp_mo notes" database there: one row per note, with a one-tap Grade
# (GREAT/GOOD/BAD) that is read back every build (no expiry). The day's first note @mentions
# the workspace's only person, which sends a push notification.
NOTION_TOKEN=
# The connected page: its URL or id.
NOTION_PAGE_ID=

# ---------------------------------------------------------------------------
# 6. PATHS
# ---------------------------------------------------------------------------
# Where finished editions are dropped (point at a synced folder to read on mobile).
EDITION_DIR=./editions
# Calibration level, run log, seen items, velocity snapshots. Must persist between runs.
STATE_DIR=./state
