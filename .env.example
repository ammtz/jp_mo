# Copy to .env (gitignored). Never commit real values.

# Vercel AI Gateway (from `npx vercel ai-gateway setup`; use an API key, not an OIDC token)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh

# Judge: jev (default) or chat (fallback, any gateway chat model)
JUDGE=jev
JEV_MODEL=typesafe-ai/jev
CHAT_MODEL=moonshotai/kimi-k3

# Sources
YOUTUBE_API_KEY=
GITHUB_TOKEN=

# Paths
EDITION_DIR=./editions
STATE_DIR=./state
